# .env.example — CampusCloud Environment Variables

# Database mode: "local" (SQLite) or "aws" (DynamoDB)
DB_MODE=local

# SQLite database path (used when DB_MODE=local)
SQLITE_PATH=campuscloud.db

# AWS Configuration (required when DB_MODE=aws)
# AWS credentials should be provided via IAM Role on EC2, NOT hardcoded here
AWS_REGION=us-east-1
DYNAMO_TABLE=campus_students

# Flask Configuration
PORT=5000
FLASK_DEBUG=true

# Frontend API URL (set in frontend/.env)
# VITE_API_URL=http://localhost:5000
